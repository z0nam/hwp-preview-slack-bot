<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template macOS LaunchAgent for hwp-pdf-slack-bot.

  1. Copy this file to  ~/Library/LaunchAgents/com.<your-user>.hwp-pdf-bot.plist
  2. Replace the placeholders below:

       __USER__          your macOS username (e.g.  alice)
       __HOME__          your home directory  (e.g.  /Users/alice)
       __PROJECT_PATH__  full path to this repo's working copy
                         (e.g.  /Users/alice/dev/hwp-pdf-slack-bot)

     The Label should match the filename, i.e.  com.<your-user>.hwp-pdf-bot

  3. Load it:
       launchctl load -w ~/Library/LaunchAgents/com.<your-user>.hwp-pdf-bot.plist

  Notes:
  - Adjust the PATH below if your uv lives elsewhere, or if you are on
    Intel macOS (replace /opt/homebrew/bin with /usr/local/bin).
  - LaunchAgents run inside a GUI user session — your Mac must be set
    to auto-login and to not sleep for unattended uptime.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.__USER__.hwp-pdf-bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PROJECT_PATH__/scripts/run_bot.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_PATH__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/hwp-pdf-bot.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/hwp-pdf-bot.err</string>
</dict>
</plist>
